<Project Sdk="Microsoft.NET.Sdk.Web">
    <PropertyGroup>
        <!-- SPT 4.1 server runs on net10.0; the 4.1.x SPTarkov packages ship lib/net10.0 only. -->
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>MoreCheckmarks</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <OutputType>Library</OutputType>
        <!-- Single source of truth: MoreCheckmarksBackend.Version reads this off the assembly. -->
        <Version>3.0.0</Version>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
        <PlatformTarget>x64</PlatformTarget>
        <!-- Don't generate PDB or other extra files -->
        <DebugType>none</DebugType>
        <DebugSymbols>false</DebugSymbols>
        <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <!-- This is a class-library mod, not a web app: don't emit *.staticwebassets.* files -->
        <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
        <!-- Don't copy dependencies to output -->
        <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    </PropertyGroup>

    <!-- Build output goes to dist folder, mirroring the install root. SPT 4.1 renamed the
         server tree from SPT\ to SPT_Runtime; the subpaths below it are unchanged. -->
    <PropertyGroup>
        <ServerModDir>SPT_Runtime\user\mods\MoreCheckmarksBackend</ServerModDir>
        <DistDir>$(MSBuildProjectDirectory)\..\dist</DistDir>
        <OutputPath>$(DistDir)\$(ServerModDir)\</OutputPath>
        <PackageOutputDir Condition="'$(PackageOutputDir)' == ''">$(MSBuildProjectDirectory)\..</PackageOutputDir>
    </PropertyGroup>

    <!--
      SPT install root for the local dev copy, resolved in this order (same as the client project):
        1. -p:SPTPath=<path> on the command line
        2. the SPTPATH environment variable
        3. three directories up - this repo is expected to live at <SPT>/moddev/MoreCheckmarks
    -->
    <PropertyGroup>
        <SPTPath Condition="'$(SPTPath)' == '' AND '$(SPTPATH)' != ''">$(SPTPATH)</SPTPath>
        <SPTPath Condition="'$(SPTPath)' == ''">$(MSBuildProjectDirectory)\..\..\..</SPTPath>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
        <WarningLevel>8</WarningLevel>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
        <WarningLevel>8</WarningLevel>
    </PropertyGroup>

    <ItemGroup>
        <!--
          Must track the installed server: 4.0 packages compile fine but fail to load at runtime
          ("Could not load type ... AbstractModMetadata"), because 4.1 replaced that abstract class
          with the IModMetadata interface. Installed runtime is 4.1.3; 4.1.2 is the newest published
          package, and is binary-compatible for the surface this mod uses.
        -->
        <PackageReference Include="SPTarkov.Common" Version="4.1.2" PrivateAssets="all" />
        <PackageReference Include="SPTarkov.DI" Version="4.1.2" PrivateAssets="all" />
        <PackageReference Include="SPTarkov.Server.Core" Version="4.1.2" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <None Include="quest-id-reference.txt" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <!--
      Build-order only: PackageMod (below) reads dist\, which the client project also writes into,
      so the client must build first. ReferenceOutputAssembly=false means this adds ordering
      without referencing the net472 assembly from this net10.0 project.
    -->
    <ItemGroup>
        <ProjectReference Include="..\Client\MoreCheckmarks.csproj"
                          ReferenceOutputAssembly="false"
                          SkipGetTargetFrameworkProperties="true"
                          Private="false"
                          ExcludeAssets="all"
                          PrivateAssets="all" />
    </ItemGroup>

    <!--
      Debug: deploy straight into the local SPT install so the dev environment picks the mod up.
      Copies the whole staged mod folder (dll + deps.json + quest-id-reference.txt), not just the
      dll, so a stale reference file can't linger next to a fresh build.
    -->
    <Target Name="CopyToSPT" AfterTargets="Build"
            Condition="'$(Configuration)' == 'Debug' AND Exists('$(SPTPath)\SPT_Runtime\user\mods')">
        <ItemGroup>
            <_StagedServerMod Include="$(OutputPath)**\*" />
        </ItemGroup>
        <Copy SourceFiles="@(_StagedServerMod)"
              DestinationFolder="$(SPTPath)\$(ServerModDir)\%(RecursiveDir)" />
        <Message Text="Deployed MoreCheckmarksBackend to $(SPTPath)\$(ServerModDir)" Importance="high" />
    </Target>

    <!--
      Package the full mod - client plugin and server mod together - as one archive at the repo
      root, laid out so it extracts directly over the SPT install root.
      dist\ can contain old SPT 4.0 output, obsolete assets, or local config files. Copy only the
      distribution manifest into a fresh staging directory before zipping. Add new shipped assets
      to this manifest. The build-order ProjectReference above guarantees the client is built first.
    -->
    <Target Name="PackageMod" AfterTargets="CopyToSPT"
            Condition="'$(Configuration)' == 'Release' OR '$(Configuration)' == 'Debug'">
        <PropertyGroup>
            <_PackageStagingDir>$(IntermediateOutputPath)package\</_PackageStagingDir>
        </PropertyGroup>
        <ItemGroup>
            <_PackageFile Include="BepInEx\plugins\MoreCheckmarks\MoreCheckmarks.dll" />
            <_PackageFile Include="BepInEx\plugins\MoreCheckmarks\MoreCheckmarksAssets" />
            <_PackageFile Include="$(ServerModDir)\$(TargetFileName)" />
            <_PackageFile Include="$(ServerModDir)\$(AssemblyName).deps.json" />
            <_PackageFile Include="$(ServerModDir)\quest-id-reference.txt" />
        </ItemGroup>
        <Error Condition="!Exists('$(DistDir)\%(_PackageFile.Identity)')"
               Text="Missing package file: $(DistDir)\%(_PackageFile.Identity). Build both projects before packaging." />
        <RemoveDir Directories="$(_PackageStagingDir)" />
        <Copy SourceFiles="@(_PackageFile->'$(DistDir)\%(Identity)')"
              DestinationFiles="@(_PackageFile->'$(_PackageStagingDir)%(Identity)')" />
        <MakeDir Directories="$(PackageOutputDir)" />
        <ZipDirectory SourceDirectory="$(_PackageStagingDir)"
                      DestinationFile="$(PackageOutputDir)\MoreCheckmarks-$(Version).zip"
                      Overwrite="true"
                      Condition="'$(Configuration)' == 'Release'" />
        <ZipDirectory SourceDirectory="$(_PackageStagingDir)"
                      DestinationFile="$(PackageOutputDir)\MoreCheckmarks-Debug-$(Version).zip"
                      Overwrite="true"
                      Condition="'$(Configuration)' == 'Debug'" />
    </Target>
</Project>
