<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>MoreCheckmarks.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Link the pure source under test; no game/Unity dependencies. -->
    <Compile Include="..\Client\QuestPrerequisites.cs" />
    <Compile Include="..\Client\Models.cs" />
    <Compile Include="..\Client\InventoryCounts.cs" />
    <Compile Include="..\Client\Localization.cs" />
    <Compile Include="..\Client\QuestFirFilter.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- The language files as they ship, so the tests check the real ones. -->
    <None Include="..\Client\Locales\*.json" Link="Locales\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
